            android:targetPackage="com.bissbilanz.android"
            android:targetClass="com.bissbilanz.android.MainActivity">
            <extra
                android:name="navigate_to"
                android:value="scanner" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="log_weight"
