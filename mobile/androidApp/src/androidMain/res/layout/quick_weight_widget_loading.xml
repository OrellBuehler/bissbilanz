<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the host until the first Glance update lands. Separate from
     quick_weight_widget_preview because that one carries a placeholder weight,
     which would read as a real reading on a widget the user just placed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_widget_scale"
        android:contentDescription="@string/weight_widget_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/weight_widget_tap_to_log"
        android:textSize="12sp" />

</LinearLayout>
