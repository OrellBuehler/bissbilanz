<?xml version="1.0" encoding="utf-8"?>
<!-- Also used as android:initialLayout, so every element here must be a class
     RemoteViews accepts (@RemoteView-annotated). A plain <View> is not one, and
     the host silently falls back to its "Problem loading widget" error view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?android:attr/colorControlNormal"
            android:importantForAccessibility="no" />

    </LinearLayout>

</LinearLayout>
