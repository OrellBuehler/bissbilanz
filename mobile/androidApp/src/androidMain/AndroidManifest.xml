<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Ongoing "fast in progress" notification and supplement reminders; both
         features work without it, only their notifications are missing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reboot clears all pending alarms, so supplement reminders must re-arm. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect: weight and sleep both ways, nutrition write-only. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BissbilanzApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Bissbilanz"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bissbilanz">

        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Health Connect opens this to show why the app wants health data;
                 without it the permission request is rejected. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- OAuth deep link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="bissbilanz"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.MacroWidgetReceiver"
            android:exported="true"
            android:label="@string/macro_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/macro_widget_info" />
        </receiver>

        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".widget.MacroWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.QuickScanWidgetReceiver"
            android:exported="true"
            android:label="@string/scan_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_scan_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickWeightWidgetReceiver"
            android:exported="true"
            android:label="@string/weight_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_weight_widget_info" />
        </receiver>

        <activity
            android:name=".widget.QuickWeightActivity"
            android:exported="false"
            android:theme="@style/Theme.Bissbilanz.Dialog" />

        <receiver
            android:name=".widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/favorites_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.DayOverviewWidgetReceiver"
            android:exported="true"
            android:label="@string/day_overview_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_overview_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_add_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Exported by requirement, but guarded by START_VIEW_PERMISSION_USAGE,
             a signature-level permission only the system holds. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Receives log commands from a paired Wear OS watch. -->
        <service
            android:name=".wear.WearMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bissbilanz" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bissbilanz" />
            </intent-filter>
        </service>

        <receiver
            android:name=".fasting.EndFastReceiver"
            android:exported="false" />

        <!-- Supplement reminders. The first two are targeted only by our own explicit,
             immutable PendingIntents; the third needs an intent-filter for the system
             broadcasts, which are exempt from the implicit-broadcast ban. -->
        <receiver
            android:name=".reminders.SupplementReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.SupplementReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootAndTimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- AppCompat's own store for the per-app language on API < 33, where the
             platform has none. Declared disabled: the class is only a metadata holder. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>
</manifest>
