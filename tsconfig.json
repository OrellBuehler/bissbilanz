{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"csp.config.ts",
		"drizzle.config.ts",
		"playwright.config.ts",
		"tests"
	],
	"exclude": ["src/service-worker"]
}
