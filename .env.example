# Infomaniak OIDC
INFOMANIAK_CLIENT_ID=
INFOMANIAK_CLIENT_SECRET=
INFOMANIAK_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Optional sign-in providers. Leave a pair unset to hide that provider.
# Redirect URIs: ${PUBLIC_APP_URL}/api/auth/callback/<provider>
# and ${PUBLIC_APP_URL}/api/auth/mobile/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Sign in with Apple. APPLE_SERVICES_ID is the Services ID (web flow), and
# APPLE_PRIVATE_KEY is the .p8 contents with newlines escaped as \n.
# Apple only redirects to verified HTTPS domains, so this cannot be tested
# against localhost — leave unset in local development.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Bundle id of the iOS app, for native Sign in with Apple tokens.
APPLE_BUNDLE_ID=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/bissbilanz
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_APPLICATION_NAME=bissbilanz

# Session
# Generate with: openssl rand -base64 32
SESSION_SECRET=generate-random-32-byte-string

# App
PUBLIC_APP_URL=http://localhost:4000

# MCP (optional)
MCP_ENDPOINT_ENABLED=false

# Sentry (optional - error tracking). The SDK only starts when BOTH are set, so a
# DSN in a local .env never reports into the live project unless you also pick an
# environment (e.g. development).
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=

# Stripe embedded buy button for the landing page's Support section. Both are
# public values — a publishable key can only create payments, never read or move
# money. Leave unset and the section falls back to a plain payment link.
PUBLIC_STRIPE_BUY_BUTTON_ID=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Test mode (NEVER in production — startup refuses TEST_MODE when NODE_ENV=production)
# TEST_MODE=true
# TEST_AUTH_TOKEN=test-integration-token   # bearer token accepted as test auth bypass; required when TEST_MODE=true
# TEST_USER_ID=00000000-0000-0000-0000-000000000001
