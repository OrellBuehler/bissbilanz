{
	"name": "Disable direct push",
	"target": "branch",
	"enforcement": "active",
	"conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
	"bypass_actors": [
		{ "actor_id": 15368, "actor_type": "Integration", "bypass_mode": "always" },
		{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request" }
	],
	"rules": [
		{ "type": "deletion" },
		{ "type": "non_fast_forward" },
		{
			"type": "pull_request",
			"parameters": {
				"required_approving_review_count": 0,
				"dismiss_stale_reviews_on_push": false,
				"required_reviewers": [],
				"require_code_owner_review": false,
				"require_last_push_approval": false,
				"required_review_thread_resolution": false,
				"require_extra_approval_for_unattributed_changes": true,
				"allowed_merge_methods": ["merge"]
			}
		},
		{
			"type": "required_status_checks",
			"parameters": {
				"strict_required_status_checks_policy": false,
				"do_not_enforce_on_create": false,
				"required_status_checks": [
					{ "context": "quality", "integration_id": 15368 },
					{ "context": "api-contract", "integration_id": 15368 },
					{ "context": "e2e", "integration_id": 15368 },
					{ "context": "integration-tests", "integration_id": 15368 },
					{ "context": "docker-smoke-test", "integration_id": 15368 },
					{ "context": "android-gate", "integration_id": 15368 },
					{ "context": "ios-gate", "integration_id": 15368 },
					{ "context": "migration-gate", "integration_id": 15368 }
				]
			}
		}
	]
}
