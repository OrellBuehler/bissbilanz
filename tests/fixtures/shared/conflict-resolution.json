{
	"$comment": "Shared offline-sync conflict handling: how a queued write is disposed of for each server response. Driven through the real drain loop on web, Android and iOS.",
	"implementations": {
		"syncOutcome": ["web", "kotlin", "swift"]
	},
	"cases": [
		{
			"fn": "syncOutcome",
			"name": "update_409_server_newer_is_dropped_with_notice",
			"input": {
				"op": "update",
				"status": 409,
				"conflictHeader": "server-newer"
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": true
			}
		},
		{
			"fn": "syncOutcome",
			"name": "delete_409_server_newer_is_dropped_with_notice",
			"input": {
				"op": "delete",
				"status": 409,
				"conflictHeader": "server-newer"
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": true
			}
		},
		{
			"fn": "syncOutcome",
			"name": "create_409_server_newer_is_dropped_with_notice",
			"input": {
				"op": "create",
				"status": 409,
				"conflictHeader": "server-newer"
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": true
			}
		},
		{
			"fn": "syncOutcome",
			"name": "update_409_without_header_is_parked",
			"input": {
				"op": "update",
				"status": 409,
				"conflictHeader": null
			},
			"expected": {
				"queue": "parked",
				"conflictNotice": false
			}
		},
		{
			"fn": "syncOutcome",
			"name": "create_409_without_header_is_parked",
			"input": {
				"op": "create",
				"status": 409,
				"conflictHeader": null
			},
			"expected": {
				"queue": "parked",
				"conflictNotice": false
			}
		},
		{
			"fn": "syncOutcome",
			"name": "update_404_reports_deleted_elsewhere",
			"input": {
				"op": "update",
				"status": 404,
				"conflictHeader": null
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": true
			}
		},
		{
			"fn": "syncOutcome",
			"name": "update_410_reports_deleted_elsewhere",
			"input": {
				"op": "update",
				"status": 410,
				"conflictHeader": null
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": true
			}
		},
		{
			"fn": "syncOutcome",
			"name": "delete_404_is_idempotent_success",
			"input": {
				"op": "delete",
				"status": 404,
				"conflictHeader": null
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": false
			}
		},
		{
			"fn": "syncOutcome",
			"name": "delete_410_is_idempotent_success",
			"input": {
				"op": "delete",
				"status": 410,
				"conflictHeader": null
			},
			"expected": {
				"queue": "removed",
				"conflictNotice": false
			}
		},
		{
			"fn": "syncOutcome",
			"name": "create_404_missing_reference_is_parked",
			"input": {
				"op": "create",
				"status": 404,
				"conflictHeader": null
			},
			"expected": {
				"queue": "parked",
				"conflictNotice": null
			},
			"divergences": [
				{
					"platform": "web",
					"expected": {
						"queue": "removed",
						"conflictNotice": true
					},
					"reason": "Web treats every 404/410 on a non-DELETE as \"record deleted elsewhere\" and drops the queued create; the apps park it so the logged meal stays visible."
				}
			]
		},
		{
			"fn": "syncOutcome",
			"name": "update_400_is_parked",
			"input": {
				"op": "update",
				"status": 400,
				"conflictHeader": null
			},
			"expected": {
				"queue": "parked",
				"conflictNotice": false
			}
		},
