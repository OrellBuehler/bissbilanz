					"Total Sugars 12g",
					"Protein 3g"
				]
			},
			"expected": {
				"calories": 240,
				"protein": 3,
				"carbs": 37,
				"fat": 8,
				"fiber": 4,
				"sugar": 12,
				"saturatedFat": 1,
				"salt": null,
				"sodium": 200,
				"isVolume": false
			}
		},
