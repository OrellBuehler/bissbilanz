{
	"$comment": "Shared nutrition label parsing: OCR rows to nutrient values, basis detection and decimal normalisation.",
	"tolerance": 1e-9,
	"implementations": {
		"parseRows": ["web", "kotlin", "swift"],
		"isVolumeBasis": ["web", "kotlin", "swift"],
		"parseDecimal": ["web", "kotlin", "swift"]
	},
	"cases": [
		{
			"fn": "parseRows",
			"name": "german_eu_panel_comma_decimals",
			"input": {
				"rows": [
					"Nährwerte pro 100 g",
					"Energie 1569 kJ / 375 kcal",
					"Fett 4,5 g",
					"davon gesättigte Fettsäuren 1,2 g",
					"Kohlenhydrate 71,4 g",
					"davon Zucker 14,0 g",
					"Ballaststoffe 2,0 g",
					"Eiweiß 9,7 g",
					"Salz 1,28 g"
				]
			},
			"expected": {
				"calories": 375,
				"protein": 9.7,
				"carbs": 71.4,
				"fat": 4.5,
				"fiber": 2,
				"sugar": 14,
				"saturatedFat": 1.2,
				"salt": 1.28,
				"sodium": null,
				"isVolume": false
			}
		},
		{
			"fn": "parseRows",
			"name": "english_eu_panel_point_decimals",
			"input": {
				"rows": [
					"Energy 1569 kJ / 375 kcal",
					"Fat 4.5 g",
					"of which saturates 1.2 g",
					"Carbohydrate 71.4 g",
					"of which sugars 14 g",
					"Fibre 2 g",
					"Protein 9.7 g",
					"Salt 1.28 g"
				]
			},
			"expected": {
				"calories": 375,
				"protein": 9.7,
				"carbs": 71.4,
				"fat": 4.5,
				"fiber": 2,
				"sugar": 14,
				"saturatedFat": 1.2,
				"salt": 1.28,
				"sodium": null,
				"isVolume": false
			}
		},
		{
			"fn": "parseRows",
			"name": "us_panel_with_percent_dv_and_sodium",
			"input": {
				"rows": [
					"Nutrition Facts",
					"Serving size 1 cup",
					"Calories 240",
					"Total Fat 8g 10%",
					"Saturated Fat 1g 5%",
					"Trans Fat 0g",
					"Sodium 200mg 9%",
					"Total Carbohydrate 37g 13%",
