			"name": "two_column_drink_panel_per_100ml_and_per_can",
			"input": {
				"rows": [
					"Nährwerte pro 100 ml pro Dose 250 ml",
					"Energie kJ/kcal 180/42 450/105",
					"Fett 0 0",
					"Kohlenhydrate 10,6 26,5",
					"davon Zucker 10,6 26,5",
					"Eiweiß 0,5 1,3",
					"Salz 0,02 0,05"
				]
			},
			"expected": {
				"calories": 42,
